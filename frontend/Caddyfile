# Servidor del sitio estatico en el servidor propio.
#
# Traduce a Caddy las reglas que Render aplicaba como Static Site, con
# una diferencia deliberada: aqui NO se proxya /api. En el servidor
# propio eso lo enruta kamal-proxy antes de llegar a este contenedor
# (comprobado el 12 ago 2026: dos apps de Kamal comparten host
# repartiendose por prefijo de ruta), asi que el navegador sigue viendo
# un solo origen y ADR-09 queda intacto sin CORS.
#
# La direccion es un puerto y NO un dominio a proposito: quien termina
# TLS es kamal-proxy. Si Caddy viera un nombre de dominio intentaria
# emitir su propio certificado y fallaria de una forma que no senala la
# causa.
:8080 {
	root * /srv

	# El CDN de Render comprimia por su cuenta; aqui no hay CDN. Sin esto
	# los bundles viajan en crudo y la medicion de Lighthouse cae ~15
	# puntos de Performance, que parece una regresion y no lo es.
	encode zstd gzip

	header {
		# HSTS (ADR-11). Arranco con 1 dia el 19 ago 2026 y paso a un ano
		# el 28 sep, tras seis semanas estable: era el final de la
		# escalera prevista (86400 -> ... -> 31536000). "preload" NO se
		# agrega: es practicamente irreversible.
		# includeSubDomains obliga a que cualquier subdominio nuevo nazca
		# con TLS; kamal-proxy lo emite solo, asi que es asumible.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Render la mandaba por su cuenta; aqui hay que declararla.
		X-Content-Type-Options "nosniff"
		# El sitio no se embebe en ningun otro (clickjacking).
		X-Frame-Options "DENY"
		# Al salir a otro dominio solo viaja el origen, no la ruta.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Ninguna pagina usa camara, microfono ni ubicacion.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# CSP en Report-Only primero, a proposito: una politica mal
		# calibrada no da error visible — deja de cargarse una fuente o
		# un script y la pagina simplemente se ve rota, sin nada en la
		# respuesta que lo explique. En Report-Only el navegador aplica
		# nada y solo avisa por consola, asi que se puede recorrer el
		# sitio y ver que se habria bloqueado antes de hacerla efectiva.
		#
		# Que necesita cada directiva hoy:
		# - script-src: Angular emite dos <script> en linea (event
		#   replay de la hidratacion) cuyo hash cambia en cada build, asi
		#   que 'unsafe-inline' es la unica salida sin desactivar la
		#   hidratacion. Los dominios de GA4 y Clarity van aqui: solo
		#   cargan si el visitante acepta, pero la CSP se evalua siempre.
		# - style-src: Angular inyecta estilos en ejecucion. Ya no hace
		#   falta fonts.googleapis.com: las fuentes se autoalojan (P2-6),
		#   asi que font-src 'self' basta.
		# - img-src: 'self' y data:. El comentario anterior decia que el
		#   demo carga imagenes de terceros y ESO YA NO ES CIERTO: llegan
		#   en base64 desde el backend (demo-diseno.ts), asi que no hace
		#   falta abrir ningun host de imagenes.
		# - connect-src: la API es del mismo origen (ADR-09); se anaden
		#   los destinos de medicion.
		# - frame-ancestors 'none' repite X-Frame-Options para los
		#   navegadores que ya solo miran la CSP.
		#
		# PENDIENTE: pasar de Report-Only a Content-Security-Policy tras
		# recorrer el sitio sin avisos (ISS-178).
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://c.clarity.ms; connect-src 'self' https://www.google-analytics.com https://*.clarity.ms; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}

	# 404 con cara: sin esto la respuesta era correcta (404 real) pero
	# con el cuerpo vacio, y una persona no sabe a donde ir (QA6). El
	# estado sigue siendo 404: file_server dentro de handle_errors lo
	# conserva.
	handle_errors {
		@noEncontrado expression {err.status_code} == 404
		handle @noEncontrado {
			rewrite * /404.html
			file_server
		}
	}

	# El Cache-Control va DENTRO de cada handle y no aqui arriba: con dos
	# directivas `header` sobre el mismo campo gana la generica, no la
	# especifica (comprobado — el matcher casa, pero el valor lo pisa la
	# de arriba). Los `handle` son excluyentes, asi que cada respuesta
	# recibe exactamente una.

	# Healthcheck de kamal-proxy (su ruta por defecto es /up). Responder
	# aqui evita depender de que exista una ruta de la aplicacion.
	handle /up {
		respond "OK" 200
	}

	# 301 de www al dominio raiz, que hoy hace Render. Va aqui y no en
	# kamal-proxy: su binario tiene --canonical-host, pero Kamal no
	# expone esa clave en deploy.yml y regenera el `kamal-proxy deploy`
	# en cada despliegue, asi que puesta a mano duraria hasta el
	# siguiente push y desapareceria sin avisar. Aqui esta versionada.
	# Funciona porque kamal-proxy preserva el Host original (comprobado).
	@www host www.crearcodecesar.com
	redir @www https://crearcodecesar.com{uri} permanent

	# Reglas 2 a 7 del render.yaml: rutas de sesion (RenderMode.Client).
	# No existen como archivo, se sirven con el cascaron del SPA. Es
	# index.csr.html y NO index.html: este ultimo es la Home ya
	# prerenderizada, y servirla bajo /admin mostraria el contenido de la
	# Home hasta que el router lo corrigiera.
	@sesion path /admin /admin/* /mi-cuenta /mi-cuenta/* /verificar-correo /restablecer-contrasena
	handle @sesion {
		header Cache-Control "no-cache"
		rewrite * /index.csr.html
		file_server
	}

	# Los bundles de Angular llevan hash en el nombre, asi que el
	# contenido bajo una misma URL no cambia nunca.
	@hasheados path *.js *.css
	handle @hasheados {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Fuentes autoalojadas (P2-6). Sin esta regla caian en el handle
	# final con no-cache y se volverian a pedir en cada visita, que es
	# justo lo que se gano al traerlas del CDN de Google.
	#
	# Un ano, pero SIN immutable: el nombre no lleva hash, asi que si
	# algun dia se cambia el archivo hay que renombrarlo — con immutable
	# el navegador no volveria a preguntar ni forzando recarga.
	@fuentes path *.woff2
	handle @fuentes {
		header Cache-Control "public, max-age=31536000"
		file_server
	}

	# Reglas 8 y 9 del render.yaml: paginas prerenderizadas. Alla hacian
	# falta dos reglas explicitas porque Render solo resuelve el index de
	# una carpeta cuando la URL trae barra final (/contacto/ si,
	# /contacto no). try_files cubre los dos casos de una vez.
	#
	# No hay comodin final a proposito: una ruta inexistente responde 404
	# de verdad en vez de 200 con el cascaron del SPA.
	handle {
		# El HTML se revalida siempre: si no, un despliegue nuevo tarda
		# en verse porque el navegador se queda con la copia vieja.
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html
		file_server
	}
}

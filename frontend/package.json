{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run generar:estaticos",
    "generar:estaticos": "esbuild scripts/generar-estaticos.ts --bundle --platform=node --format=esm --outfile=dist/.generar-estaticos.mjs --log-level=warning && node dist/.generar-estaticos.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "servir:estatico": "node scripts/servir-estatico.mjs",
    "verificar:rutas": "node scripts/verificar-rutas-estaticas.mjs",
    "verificar:servido": "node scripts/verificar-rutas-servidas.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "//": "La matriz exacta que exige Angular 22. No vale un '>=22' a secas: Node 24.14.1 lo cumpliria y el CLI lo rechaza.",
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.7",
    "marked": "^18.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "lighthouse": "^13.4.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
